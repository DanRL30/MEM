# Variables de entorno de la API. Copia este archivo como `.env` y complétalo
# solo para desarrollo local; `.env` está en `.gitignore` y no se versiona.
#
# En Azure ninguna de estas variables se escribe a mano: la plantilla Bicep las
# inyecta en la configuración de la aplicación, y los secretos se resuelven por
# identidad administrada contra Key Vault. Aquí van los nombres, nunca un valor.
#
# Todas tienen valor por defecto en apps/api/src/minsur_api/config.py, de modo
# que la API arranca sin este archivo: lo que falte se manifiesta al usar la
# función que lo necesita, no al levantar el proceso.

# Entorno de ejecución: local | dev | qa | prod.
ENTORNO=local

# --- Identidad (Entra ID) ---------------------------------------------------
# Las provee MINSUR al registrar la aplicación en su tenant (R-42).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Datos ------------------------------------------------------------------
# Aprovisionadas por la plantilla Bicep; dependen de R-23.
ALMACENAMIENTO_CUENTA=
SQL_SERVIDOR=
SQL_BASE_DATOS=
KEY_VAULT_URI=

# --- Publicación documental -------------------------------------------------
# Sitio y biblioteca de SharePoint donde se publican los entregables.
SHAREPOINT_SITIO=
SHAREPOINT_BIBLIOTECA=

# --- Nivel de servicio ------------------------------------------------------
# Apertura del tablero comprometida por debajo de 5 s. El umbral de la
# evaluación estándar lo fija MINSUR (R-51).
SLO_TABLERO_MS=5000
