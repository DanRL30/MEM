{
  "name": "@minsur/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos TypeScript generados desde el esquema OpenAPI de la API. No editar a mano.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api.d.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"sin lint propio\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
