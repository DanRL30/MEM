{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "networking": {
    "allowedIpRanges": ["AzureFrontDoor.Backend"]
  },

  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "headers": {
        "Cache-Control": "no-store, must-revalidate"
      }
    }
  ],

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,svg,ico,woff2}"]
  },

  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://login.microsoftonline.com https://*.azure-api.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()"
  },

  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" },
    "403": { "rewrite": "/sin-permiso.html" },
    "404": { "rewrite": "/index.html" }
  }
}
